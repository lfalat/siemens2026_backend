# Per-person settings for scripts/azure/provision.sh. Copy to infra/azure.env (gitignored) and fill in.
# Nothing in here is a secret; it is gitignored because it differs per person and per subscription.
# Full walkthrough: docs/operations/azure-deployment-guide.md

# Subscription to deploy into (az account list -o table). The script refuses to run against any other.
HH_SUBSCRIPTION_ID=

# Region and environment name. Keep "prod" unless this is a temporary rehearsal group.
HH_LOCATION=germanywestcentral
HH_ENVIRONMENT=prod

# The operator, in the subscription's tenant:
#   az ad signed-in-user show --query id -o tsv
#   az ad signed-in-user show --query userPrincipalName -o tsv
HH_OPERATOR_OBJECT_ID=
HH_OPERATOR_UPN=

# Your own SSH public key, for the azureops admin user (used over NetBird only).
HH_OPERATOR_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# GitHub repository as owner/name. Only images signed by its deploy workflow are accepted on the VM.
HH_GITHUB_REPOSITORY=

# Alerts and budget notifications.
HH_ALERT_EMAIL=

# The app is served at https://<label>.<location>.cloudapp.azure.com. The label is unique per region; to keep
# the same URL on another subscription, delete the old resource group first (guide §11.3).
HH_DNS_LABEL=healthyhires

# The company Entra tenant's app registrations (guide §4). They do not depend on the Azure subscription, so
# they stay the same when the deployment moves to another one.
HH_ENTRA_TENANT_ID=
HH_ENTRA_CLIENT_ID=
HH_API_SCOPE=
# A verified domain of the tenant (Entra admin center → Domain names); staff accounts the API creates sign in as
# username@<domain>.
HH_ENTRA_USER_DOMAIN=

# Monthly cost budget with e-mail alerts at 80 % spent and 100 % forecast, in the billing currency. Some student
# offers do not support budgets; provision.sh then warns and carries on (watch Cost analysis by hand instead).
HH_BUDGET_AMOUNT=100

# Optional overrides. Uncomment only when a default does not work for this subscription.
# HH_VM_SIZE=Standard_B2s
# HH_POSTGRES_VERSION=18
# HH_IMAGE_SKU=10-gen2
# HH_ENABLE_LOCKS=false              # rehearsal groups only
# HH_ENABLE_PURGE_PROTECTION=false   # rehearsal groups only
