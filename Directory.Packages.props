<Project>
  <!-- Versions for the root-repo projects only (AppHost, tests/e2e). Everything under api/ is versioned by
       api/Directory.Packages.props, so api/Api.slnx restores and builds on its own. -->
  <ItemGroup>
    <!-- Aspire hosting / orchestration; keep in step with the Aspire.AppHost.Sdk version in AppHost.csproj. -->
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
    <!-- End-to-end tests (tests/e2e, ADR-019). The xunit packages stay in step with api/Directory.Packages.props. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- `just e2e-install` installs the browsers of exactly this version. -->
    <PackageVersion Include="Microsoft.Playwright.Xunit.v3" Version="1.63.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
