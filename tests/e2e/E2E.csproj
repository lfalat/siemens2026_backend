<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser end-to-end tests against a running stack (ADR-019, docs/testing/e2e.md). They start nothing
       themselves: run the AppHost and the frontend first. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The test user's credentials live in user secrets: dotnet user-secrets set E2E:Username ... -->
    <UserSecretsId>healthyhires-e2e</UserSecretsId>
    <!-- Test names use underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Playwright" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
